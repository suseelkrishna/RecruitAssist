# Copy this file to .env and fill in your key. .env is ignored by git.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-5-5, the model the evals chose (see evals/results.md).
ANTHROPIC_MODEL=
# Optional. Thinking effort for the agent: low, medium, high, xhigh, or max. Defaults to low.
ANTHROPIC_EFFORT=
# Optional. Live answers allowed per day across all users. Defaults to 150.
DAILY_LIVE_CAP=150
# Optional. Set both to keep the change log, assignments, and rate limits in Upstash Redis.
# Without them the store lives in memory and resets on restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

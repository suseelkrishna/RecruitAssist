# Copy this file to .env and fill in your key. .env is ignored by git.
ANTHROPIC_API_KEY=
# Optional. For eval runs against OpenAI models only (evals/run.py). The app ignores it.
OPENAI_API_KEY=
# Optional. Defaults to claude-haiku-5-5, the model the evals chose (see evals/results.md).
# Any model ID in app/llm/models.yaml works. OpenAI models are refused by the app
# (answers come from recordings) unless ALLOW_OPENAI_LIVE=1.
ANTHROPIC_MODEL=
# Optional. Leave unset so the app only uses Claude. 1 lets the app use an OpenAI ANTHROPIC_MODEL.
ALLOW_OPENAI_LIVE=
# Optional. Thinking effort for the agent: low, medium, high, xhigh, or max. Defaults to low.
ANTHROPIC_EFFORT=
# Optional. Live answers allowed per day across all users. Defaults to 150.
DAILY_LIVE_CAP=150
# Optional. Set both to keep the change log, assignments, and rate limits in Upstash Redis.
# Without them the store lives in memory and resets on restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
